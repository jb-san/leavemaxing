# Rybbit site id for analytics.vril.tech (leave empty to disable analytics)
PUBLIC_RYBBIT_SITE_ID=

# Render AdSense units while running `astro dev`. Production builds render them
# when a slot id is set in src/config/ads.ts. Leave unset so local dev stays quiet.
# Set to false to suppress units in a production build.
PUBLIC_ADS_ENABLED=
