---
import { longDate, type NlSchoolSections } from "~/lib/landingPages";
import { fromIso } from "~/lib/dates";

interface Props {
  sections: NlSchoolSections;
}

const { sections } = Astro.props;
---

<section aria-labelledby="regio" class="card min-w-0 p-5 sm:p-6" data-nl-regions>
  <h2 id="regio" class="text-2xl font-bold">{sections.heading}</h2>
  {sections.intro.map((line) => <p class="mt-2 text-sm text-muted">{line}</p>)}
  <nav aria-label="Regio's" class="mt-4">
    <ul class="flex flex-wrap gap-2">
      {
        sections.regions.map((region) => (
          <li>
            <a class="chip" href={`#${region.region}`}>
              {region.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mt-6 flex flex-col gap-8">
    {
      sections.regions.map((region) => (
        <section aria-labelledby={region.region} data-nl-region={region.region}>
          <h3 id={region.region} class="scroll-mt-24 text-xl font-bold">
            {region.label}
          </h3>
          {region.summary.map((line) => (
            <p class="mt-2 text-sm">{line}</p>
          ))}
          <div class="mt-3 overflow-x-auto" tabindex="0" role="region" aria-label={`Schoolvakanties ${region.label}`}>
            <table class="w-full min-w-[520px] text-left text-sm">
              <thead class="text-xs uppercase tracking-wider text-muted">
                <tr>
                  <th class="pb-2 pr-4 font-bold">Vakantie</th>
                  <th class="pb-2 pr-4 font-bold">Periode</th>
                  <th class="pb-2 font-bold">Feestdagen en brugdagen erin</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {region.periods.map((period) => (
                  <tr>
                    <td class="py-2.5 pr-4 align-top font-semibold">
                      {period.name}
                      <span class="block text-xs font-normal text-muted">
                        {period.schoolYear}
                        {period.advisory ? ", adviesdatum" : ", verplicht"}
                      </span>
                    </td>
                    <td class="py-2.5 pr-4 align-top tabular-nums">{period.range}</td>
                    <td class="py-2.5 align-top text-muted">
                      {period.holidays.length === 0 && period.bridges.length === 0 && "–"}
                      {period.holidays.length > 0 && <span class="block">{period.holidays.join(", ")}</span>}
                      {period.bridges.map((bridge) => (
                        <span class="block">
                          Brugdag:{" "}
                          {bridge.days.map((day) => longDate("nl-NL", fromIso(day))).join(" en ")}
                        </span>
                      ))}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }
  </div>
  <p class="mt-6 text-xs text-muted">
    Bron:{" "}
    {
      sections.sources.map((source, index) => (
        <>
          {index > 0 && ", "}
          <a href={source.url} class="underline" rel="noopener" target="_blank">
            {source.label}
          </a>
        </>
      ))
    }
    .
    {sections.coveredUntil && ` De schoolvakanties na ${longDate("nl-NL", fromIso(sections.coveredUntil))} zijn nog niet gepubliceerd.`}
  </p>
</section>
