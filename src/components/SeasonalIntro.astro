---
interface Props {
  sentences: string[];
  links?: Array<{ href: string; label: string }>;
  updatedLabel?: string;
  updatedDate?: string;
}

const { sentences, links = [], updatedLabel, updatedDate } = Astro.props;
---

<div class="prose prose-slate max-w-none mb-8">
  {sentences.map((sentence) => <p class="text-lg">{sentence}</p>)}
  {
    links.length > 0 && (
      <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm font-semibold">
        {links.map((link) => (
          <a href={link.href} class="underline decoration-lime decoration-2 underline-offset-4">
            {link.label}
          </a>
        ))}
      </p>
    )
  }
  {
    updatedLabel && updatedDate && (
      <p class="mt-3 text-sm text-muted">
        <time datetime={updatedDate}>{updatedLabel}</time>
      </p>
    )
  }
  <slot />
</div>
