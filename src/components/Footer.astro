---
import { SITE } from "~/data/site";
import { getCopy } from "~/i18n";
import { localeAboutPath, localeContactPath } from "~/i18n/routes";
import type { Copy } from "~/i18n/types";

interface Props {
  locale?: string;
  copy?: Copy;
}

const locale = Astro.props.locale && Astro.props.locale !== "en" ? Astro.props.locale : "en";
const copy = Astro.props.copy ?? getCopy(locale);
const c = copy.chrome;
const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-[1280px] px-[max(16px,env(safe-area-inset-left))] pb-[max(24px,env(safe-area-inset-bottom))]">
  <div class="card flex flex-col gap-4 p-6 text-sm text-muted md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-1">
      <p>
        © {year}{" "}<a class="font-semibold text-ink hover:underline" href={SITE.author.url}>{SITE.author.name}</a>. {c.footerCare}
      </p>
      <p>
        {c.footerDataFrom}{" "}
        <a class="underline" href="https://github.com/commenthol/date-holidays">date-holidays</a>, {c.footerLicensed}{" "}
        <a class="underline" href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>.
      </p>
    </div>
    <nav aria-label={c.footerNav} class="flex flex-wrap items-center gap-x-5 gap-y-2 font-semibold">
      <a href={localeAboutPath(locale)} class="hover:text-ink">{c.footerAbout}</a>
      <a href={localeContactPath(locale)} class="hover:text-ink">{c.footerContact}</a>
      <a href="/privacy-policy/" class="hover:text-ink">{c.footerPrivacy}</a>
      <button type="button" class="appearance-none bg-transparent p-0 hover:text-ink" data-privacy-settings>{c.footerPrivacySettings}</button>
      <a href={SITE.links.github} class="hover:text-ink">GitHub</a>
      <a href={SITE.links.linkedin} class="hover:text-ink">LinkedIn</a>
    </nav>
  </div>
  <script is:inline>
    document.addEventListener("click", (event) => {
      const node = event.target instanceof Element ? event.target.closest("[data-privacy-settings]") : null;
      if (!node) return;
      window.googlefc = window.googlefc || {};
      googlefc.callbackQueue = googlefc.callbackQueue || [];
      window.googlefc && googlefc.callbackQueue.push(googlefc.showRevocationMessage);
    });
  </script>
</footer>
