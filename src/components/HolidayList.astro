---
import { countryByCode } from "~/data";
import { getCopy, intlLocale } from "~/i18n";
import { calendarLabels, countText, countryName } from "~/i18n/format";
import { fromIso, parts, weekdayMon0 } from "~/lib/dates";
import { holidayName, type HolidayFile } from "~/lib/holidays";
import { regionCopy } from "~/lib/regionLabels";

interface Props {
  file: HolidayFile;
  /** Use local region names on localized pages. */
  localizeRegions?: boolean;
  /** UI locale. English pages omit it and keep English names. */
  locale?: string;
}

const { file, localizeRegions = false, locale } = Astro.props;
const copy = getCopy(locale);
const h = copy.holiday;
const labels = calendarLabels(intlLocale(locale));
const country = countryByCode.get(file.country);
const countryLabel = countryName(file.country, intlLocale(locale), country?.name ?? file.country);
const regionName = (code: string) => {
  const source = country?.regions[code] ?? code;
  return localizeRegions ? regionCopy(file.country, code, source).name : source;
};

const tips = [h.tipMon, h.tipTue, h.tipMid, h.tipThu, h.tipFri, h.tipSat, h.tipSun];
const rows = file.holidays.map((holiday) => {
  const d = fromIso(holiday.date);
  const p = parts(d);
  const wd = weekdayMon0(d);
  const shown = holidayName(holiday, locale);
  return {
    day: p.day,
    month: labels.monthsLong[p.month - 1],
    weekday: labels.weekdaysLong[wd],
    name: shown,
    local: !locale && holiday.local && holiday.local !== holiday.name ? holiday.local : null,
    tip: tips[wd] ?? h.tipMid,
    where: holiday.regions ? holiday.regions.map(regionName).join(", ") : null,
  };
});
const nationalCount = new Set(file.holidays.filter((holiday) => holiday.national !== false).map((holiday) => holiday.date)).size;
const intro = `${countText(intlLocale(locale), nationalCount, h.intro)}${rows.some((r) => r.where) ? h.regional : ""}. ${h.bridgeNote}`;
---

<section aria-labelledby="holidays-title" class="card min-w-0 p-5 sm:p-7">
  <h2 id="holidays-title" class="text-2xl font-bold">
    {h.title.replace("{country}", countryLabel).replace("{year}", String(file.year))}
  </h2>
  <p class="mt-1 text-sm text-muted">{intro}</p>
  <div class="mt-5 overflow-x-auto" tabindex="0" role="region" aria-label={h.table}>
    <table class="w-full min-w-[520px] text-left text-sm">
      <thead class="text-xs uppercase tracking-wider text-muted">
        <tr>
          <th class="pb-3 pr-4 font-bold">{h.date}</th>
          <th class="pb-3 pr-4 font-bold">{h.name}</th>
          <th class="pb-3 font-bold">{h.tip}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {
          rows.map((r) => (
            <tr>
              <td class="py-3 pr-4 align-top">
                <span class="font-bold tabular-nums">
                  {r.day} {r.month}
                </span>
                <span class="block text-xs text-muted">{r.weekday}</span>
              </td>
              <td class="py-3 pr-4 align-top">
                <span class="font-semibold">{r.name}</span>
                {r.local && <span class="block text-xs text-muted">{r.local}</span>}
                {r.where && <span class="mt-1 block text-xs text-muted">{h.onlyIn.replace("{where}", r.where)}</span>}
              </td>
              <td class="py-3 align-top text-muted">{r.tip}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
