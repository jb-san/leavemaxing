---
import { Mascot } from "~/components/Mascot";
import Planner from "~/components/planner/Planner";
import { countryByCode, meta } from "~/data";
import { buildToday, serverPlan } from "~/data/server";
import { SITE } from "~/data/site";
import Base from "~/layouts/Base.astro";
import { defaultSettings } from "~/lib/settings";

const year = new Date().getFullYear();
const settings = defaultSettings("US", year);
const { files } = serverPlan(settings);
const popular = ["US", "GB", "DE", "FR", "ES", "IT", "NL", "IE", "MT", "AU", "CA", "IN", "BR", "JP", "SE", "PL"]
  .map((c) => countryByCode.get(c))
  .filter((c) => !!c);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "leavemaxxing",
      url: SITE.url,
      description: SITE.description,
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${SITE.url}/compare/?countries={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      name: "leavemaxxing",
      url: SITE.url,
      logo: `${SITE.url}/apple-touch-icon.png`,
      sameAs: [SITE.links.github, SITE.links.linkedin],
    },
    {
      "@type": "WebApplication",
      name: "leavemaxxing",
      url: SITE.url,
      description: SITE.description,
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Any",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
  ],
};

const steps = [
  { title: "Pick your country", text: "Public holidays for over 200 countries, down to the region." },
  { title: "Say how many days you have", text: "The planner checks every combination and picks the best one for how you like to take time off." },
  { title: "Make it yours", text: "Tap days you've already booked or can't take. The plan rebuilds around them." },
  { title: "Take it with you", text: "Share a link, add the breaks to your calendar, or save the plan in this browser." },
]
---

<Base title="leavemaxxing: turn your leave days into the most time off" description={SITE.description} jsonLd={jsonLd} wide>
  <div class="flex flex-col gap-3 pb-7 pt-3 sm:flex-row sm:items-end sm:justify-between">
    <h1 class="max-w-[16ch] text-[clamp(34px,5.4vw,64px)] font-extrabold leading-[0.95]">
      Get the most time off from your leave days
    </h1>
    <p class="max-w-[44ch] text-[15px] text-muted sm:pb-1">
      Pick your country and how many days you have. The planner puts them next to weekends and public holidays, so each
      one buys a longer break.
    </p>
  </div>

  <Planner client:load initial={settings} files={files} today={buildToday} mode="home" years={meta.years} />

  <section aria-labelledby="how" class="mt-16">
    <h2 id="how" class="text-3xl font-extrabold">How it works</h2>
    <ol class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="flex flex-col gap-1.5">
            <span class="font-display text-5xl font-black leading-none text-lime-strong" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-2 text-xl font-bold">{s.title}</h3>
            <p class="max-w-[34ch] text-sm text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="countries" class="mt-16">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2 id="countries" class="text-3xl font-extrabold">Popular countries</h2>
      <a href={`/best/${year}/`} class="text-sm font-semibold underline decoration-lime decoration-2 underline-offset-4">See where leave goes furthest</a>
    </div>
    <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
      {
        popular.map((c) => (
          <li>
            <a href={`/${c.code.toLowerCase()}/${year}/`} class="flex items-center gap-2 font-semibold decoration-lime decoration-2 underline-offset-4 hover:underline">
              <span class="text-lg leading-none" aria-hidden="true">{c.flag}</span>
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="private" class="mt-16 flex items-start gap-4 border-t border-line pt-8">
    <Mascot size={48} mood="happy" title="" />
    <div>
      <h2 id="private" class="text-xl font-bold">Your plans stay on your device</h2>
      <p class="mt-1 max-w-[62ch] text-sm text-muted">
        The planner runs in your browser. There are no accounts, saved plans are kept in this browser, and the app works
        offline after your first visit. <a href="/about/" class="font-semibold text-ink underline decoration-lime decoration-2 underline-offset-4">How the planner works</a>
      </p>
    </div>
  </section>
</Base>
