---
import { t } from "~/components/together/copy";
import Together from "~/components/together/Together";
import Base from "~/layouts/Base.astro";
---

<Base
  title="Together: plan time off with friends"
  description="Find trip dates that work for a whole group. Everyone adds the days they can't do and the leave they'll spend, and the cheapest dates come first."
  wide
>
  <Together client:only="react">
    <div slot="fallback" class="flex flex-col gap-2 pb-6 pt-3">
      <h1 class="max-w-[14ch] text-[clamp(34px,5.4vw,60px)] font-extrabold leading-[0.95]">{t.title}</h1>
      <p class="max-w-[60ch] text-muted">{t.lead}</p>
      <noscript><p class="font-semibold">{t.noScript}</p></noscript>
    </div>
  </Together>
</Base>
