---
import SavedPlans from "~/components/SavedPlans";
import Base from "~/layouts/Base.astro";
---

<Base title="My plans · leavemaxxing" description="Your saved leave plans, stored in this browser." noindex>
  <div class="flex flex-col gap-2 pb-6 pt-2">
    <h1 class="text-[clamp(32px,4.4vw,52px)] font-extrabold leading-none">My plans</h1>
    <p class="text-muted">Kept in this browser. Nothing is uploaded.</p>
  </div>
  <SavedPlans client:load />
</Base>
