---
import HolidayList from "~/components/HolidayList.astro";
import SeasonalIntro from "~/components/SeasonalIntro.astro";
import Planner from "~/components/planner/Planner";
import { countryByCode } from "~/data";
import { readHolidayFile, filesFor, buildToday } from "~/data/server";
import { locales, replaceTokens, getLocale } from "~/data/locales";
import { SITE } from "~/data/site";
import Base from "~/layouts/Base.astro";
import { intlLocale } from "~/i18n";
import { countryName, formatRangeLocale } from "~/i18n/format";
import { localizedPageAlternates, siblingLocaleAlternates } from "~/lib/hreflang";
import { regionCopy } from "~/lib/regionLabels";
import { publishedRegionCodes } from "~/lib/regionSets";
import { defaultSettings } from "~/lib/settings";
import { calculateBridgePlans } from "~/lib/bridgeDays";
import { bridgeLinkLabel, localizedSeasonal, pageJsonLd, whereFor } from "~/lib/seasonalSeo";
import { toPlanInput, yearsNeeded } from "~/lib/planInput";
import { plan } from "~/lib/planner/plan";

export function getStaticPaths() {
  const paths: Array<{ params: { locale: string; page: string } }> = [];
  const years = [2027, 2028];
  
  for (const [localeCode, locale] of Object.entries(locales)) {
    for (const year of years) {
      paths.push({
        params: {
          locale: localeCode.toLowerCase(),
          page: `${locale.slug}-${year}`
        }
      });
    }
  }
  
  return paths;
}

const { locale: localeParam, page } = Astro.params;

// Parse the page param to extract slug and year
// page format: "slug-YYYY" (e.g., "dlugie-weekendy-2027")
const yearMatch = page?.match(/-(\d{4})$/);
if (!yearMatch) {
  return Astro.redirect('/404');
}

const year = Number(yearMatch[1]);
const slug = page.slice(0, -5); // Remove "-YYYY" from end

// Find locale config
const locale = getLocale(localeParam.replace('-', '-').toUpperCase()) || 
              getLocale(`${localeParam.substring(0, 2).toLowerCase()}-${localeParam.substring(3, 5).toUpperCase()}`);

if (!locale) {
  return Astro.redirect('/404');
}

const country = countryByCode.get(locale.country);
if (!country) {
  return Astro.redirect('/404');
}
const uiLocale = intlLocale(locale.code);
const rangeText = (start: number, end: number) => formatRangeLocale(uiLocale, start, end);
const countryLabel = countryName(locale.country, uiLocale, country.name);

const settings = defaultSettings(locale.country, year);
settings.budget = locale.defaultBudget;
const files = filesFor(settings);
const file = readHolidayFile(locale.country, year);

if (!file) {
  return Astro.redirect('/404');
}

// Calculate bridge plans for different budgets
const bridgePlans = calculateBridgePlans(
  locale.country,
  null, // national page, no region
  year,
  files,
  [1, 3, 5, 10, locale.defaultBudget]
);

// Get the full plan for the default budget
const input = toPlanInput(
  settings,
  yearsNeeded(settings).map((y) => files.find((f) => f.year === y)),
  buildToday
);
const fullPlan = plan(input);
const stats = fullPlan.stats;

// Get top 3 breaks
const top = [...fullPlan.breaks]
  .filter((b) => b.leave > 0)
  .sort((a, b) => b.length / b.leave - a.length / a.leave)
  .slice(0, 3);

const h1 = replaceTokens(locale.translations.h1, { year });

const canonicalPath = `/${localeParam}/${page}/`;
const canonicalUrl = new URL(canonicalPath, SITE.url).href;

const englishUrl = `${SITE.url}/${locale.country.toLowerCase()}/${year}/`;
const hreflangs = localizedPageAlternates(
  locale.code,
  canonicalUrl,
  englishUrl,
  siblingLocaleAlternates(locale.code, year, SITE.url, Object.values(locales)),
);
const publishedRegions = country.regional
  ? publishedRegionCodes(locale.country, Object.keys(country.regions), file)
  : [];

const seasonal = localizedSeasonal({
  localeCode: locale.code,
  year,
  where: whereFor(locale.code, null),
  regional: false,
  file,
  country: locale.country,
  region: null,
  budget: locale.defaultBudget,
  daysOff: stats.daysOff,
  multiplier: stats.multiplier,
  breaks: fullPlan.breaks,
  uiLocale,
});
const title = seasonal.title;
const description = seasonal.description;
const otherYear = year === 2027 ? 2028 : 2027;
const homeLabel = locale.translations.home ?? countryLabel;
const jsonLd = pageJsonLd({
  title,
  description,
  url: canonicalUrl,
  inLanguage: locale.lang,
  applicationName: `leavemaxxing: ${locale.bridgeTerm} ${year}`,
  dateModified: seasonal.updatedDate,
  breadcrumbs: [
    { name: homeLabel, item: `${SITE.url}/${localeParam}/` },
    { name: countryLabel, item: `${SITE.url}/${locale.country.toLowerCase()}/` },
    { name: `${locale.bridgeTerm} ${year}`, item: canonicalUrl },
  ],
  faq: seasonal.faq,
});
---

<Base 
  title={title} 
  description={description} 
  lang={locale.lang}
  locale={locale.code}
  canonical={canonicalUrl}
  hreflangs={hreflangs}
  jsonLd={jsonLd}
  image={`/og/l/${localeParam}.png`}
  wide
>
  <div class="flex flex-col gap-2 pb-5 pt-2">
    <nav aria-label="Breadcrumb" class="text-sm font-semibold text-muted">
      <a href={`/${localeParam}/`} class="hover:text-ink">{locale.translations.home ?? countryLabel}</a> /
      <span>{countryLabel}</span> / 
      <span aria-current="page">{locale.bridgeTerm} {year}</span>
    </nav>
    <h1 class="text-[clamp(28px,4vw,44px)] font-extrabold leading-tight">
      {country.flag} {h1}
    </h1>
  </div>

  <SeasonalIntro
    sentences={seasonal.intro}
    links={[{ href: `/${localeParam}/${slug}-${otherYear}/`, label: bridgeLinkLabel(locale.code, otherYear) }]}
    updatedLabel={seasonal.updatedLabel}
    updatedDate={seasonal.updatedDate}
  >
    {locale.translations.notice && <p class="mt-3 text-sm text-muted">{locale.translations.notice}</p>}
  </SeasonalIntro>

  <!-- Interactive Planner -->
  <Planner client:load initial={settings} files={files} today={buildToday} mode="page" years={[year]} localizeRegions locale={locale.code} />

  <div class="mt-10 grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_340px]">
    <!-- Main content -->
    <div class="flex flex-col gap-8">
      <!-- Best Plans Section -->
      <section class="card p-5 sm:p-6">
        <h2 class="text-2xl font-bold mb-4">{replaceTokens(locale.translations.bestPlansHeading, { year })}</h2>
        <div class="space-y-6">
          {bridgePlans.filter(p => p.budget <= 10).map((bridgePlan) => (
            <div class="border-l-4 border-lime pl-4">
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-3xl font-extrabold text-lime-ink">{bridgePlan.multiplier.toFixed(1)}×</span>
                <span class="text-muted">
                  {bridgePlan.budget} {locale.translations.leaveDays.toLowerCase()} → {bridgePlan.daysOff} {locale.translations.daysOff.toLowerCase()}
                </span>
              </div>
              <div class="text-sm space-y-1">
                {bridgePlan.breaks.slice(0, 3).map((br) => {
                  return (
                    <div class="text-muted">
                      {rangeText(br.start, br.end)}: {br.leave} {locale.translations.leaveDays.toLowerCase()} → {br.length} {locale.translations.totalDays}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Holidays List -->
      <section>
        <h2 class="text-2xl font-bold mb-4">{replaceTokens(locale.translations.holidaysHeading, { year })}</h2>
        <HolidayList file={file} localizeRegions locale={locale.code} />
      </section>

      <!-- FAQ Section -->
      <section class="card p-5 sm:p-6">
        <h2 class="text-2xl font-bold mb-4">{locale.translations.faqHeading}</h2>
        <div class="space-y-6" data-seasonal-faq>
          {seasonal.faq.map((item) => (
            <div>
              <h3 class="font-bold text-lg mb-2">{item.question}</h3>
              <p class="text-muted">{item.answer}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 space-y-6">
          {locale.translations.faq.map((item) => (
            <div>
              <h3 class="font-bold text-lg mb-2">{item.question}</h3>
              <p class="text-muted">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- Sidebar -->
    <aside class="flex flex-col gap-5">
      {
        top.length > 0 && (
          <section class="card p-5 sm:p-6">
            <h2 class="text-xl font-bold">{locale.translations.bestPlansHeading.replace(` ${year}`, '')}</h2>
            <p class="mt-1 text-sm text-muted">
              {locale.translations.withBudget ? replaceTokens(locale.translations.withBudget, { budget: settings.budget }) : ""}
            </p>
            <ol class="mt-4 flex flex-col gap-3">
              {top.map((b) => (
                <li class="flex items-center gap-3">
                  <span class="grid h-11 w-14 shrink-0 place-items-center rounded-2xl bg-lime font-display text-lg font-extrabold text-lime-ink">
                    {(b.length / b.leave).toFixed(1)}×
                  </span>
                  <span class="text-sm">
                    <span class="block font-bold">{rangeText(b.start, b.end)}</span>
                    <span class="text-muted">
                      {b.leave} {locale.translations.leaveDays.toLowerCase()} → {b.length} {locale.translations.totalDays}
                    </span>
                  </span>
                </li>
              ))}
            </ol>
          </section>
        )
      }
      <section class="card p-5 sm:p-6">
        <h2 class="text-xl font-bold">{locale.translations.otherYears}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {[2027, 2028].filter(y => y !== year).map((y) => (
            <li>
              <a class="chip" href={`/${localeParam}/${slug}-${y}/`}>
                {y}
              </a>
            </li>
          ))}
        </ul>
      </section>
      {locale.translations.otherRegions && publishedRegions.length > 0 && (
        <section class="card p-5 sm:p-6">
          <h2 class="text-xl font-bold">{locale.translations.otherRegions}</h2>
          <ul class="mt-3 flex flex-col gap-1 max-h-64 overflow-y-auto text-sm">
            {publishedRegions.map((code) => {
              const other = regionCopy(locale.country, code, country.regions[code] ?? code);
              return (
                <li>
                  <a href={`/${localeParam}/${page}/${other.slug}/`} class="hover:text-lime-ink hover:underline">
                    {other.name}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}
      <section class="card p-5 sm:p-6">
        <h2 class="text-xl font-bold">{locale.translations.calculator}</h2>
        <p class="mt-2 text-sm text-muted mb-3">
          {locale.translations.adjustHint ?? ""}
        </p>
        <a href={`/${localeParam}/`} class="chip inline-block">
          {locale.translations.calculatorLink}
        </a>
      </section>
    </aside>
  </div>
</Base>
