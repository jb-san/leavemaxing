---
import GuideArticle from "~/components/guides/GuideArticle.astro";
import { guideEntries, guideSummaries } from "~/lib/guideEntries";

export async function getStaticPaths() {
  const all = await guideSummaries();
  return (await guideEntries())
    .filter(({ summary }) => summary.locale !== "en")
    .map(({ entry, summary }) => ({
      params: { locale: summary.locale.toLowerCase(), slug: summary.slug },
      props: { entry, guide: summary, all },
    }));
}

const { entry, guide, all } = Astro.props;
---

<GuideArticle entry={entry} guide={guide} all={all} />
