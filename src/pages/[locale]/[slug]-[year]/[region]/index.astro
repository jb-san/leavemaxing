---
import HolidayList from "~/components/HolidayList.astro";
import Planner from "~/components/planner/Planner";
import { countryByCode, regionName } from "~/data";
import { readHolidayFile, filesFor, buildToday } from "~/data/server";
import { locales, replaceTokens, getLocale, isRegionalCountry } from "~/data/locales";
import { SITE } from "~/data/site";
import Base from "~/layouts/Base.astro";
import { formatRange } from "~/lib/dates";
import { defaultSettings } from "~/lib/settings";
import { calculateBridgePlans, formatBreak } from "~/lib/bridgeDays";
import { toPlanInput, yearsNeeded } from "~/lib/planInput";
import { plan } from "~/lib/planner/plan";

export function getStaticPaths() {
  const paths: Array<{ params: { locale: string; slug: string; year: string; region: string } }> = [];
  const years = [2027, 2028];
  
  for (const [localeCode, locale] of Object.entries(locales)) {
    if (!isRegionalCountry(locale.country)) continue;
    
    const country = countryByCode.get(locale.country);
    if (!country || !country.regional) continue;
    
    const regionCodes = Object.keys(country.regions);
    
    for (const year of years) {
      for (const regionCode of regionCodes) {
        const regionSlug = country.regions[regionCode]
          ?.toLowerCase()
          .replace(/ä/g, 'ae')
          .replace(/ö/g, 'oe')
          .replace(/ü/g, 'ue')
          .replace(/ß/g, 'ss')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '') || regionCode.toLowerCase();
        
        paths.push({
          params: {
            locale: localeCode.toLowerCase(),
            slug: locale.slug,
            year: String(year),
            region: regionSlug
          }
        });
      }
    }
  }
  
  return paths;
}

const { locale: localeParam, slug, year: yearParam, region: regionSlug } = Astro.params;
const year = Number(yearParam);

// Find locale config
const locale = getLocale(localeParam.replace('-', '-').toUpperCase()) || 
              getLocale(`${localeParam.substring(0, 2).toLowerCase()}-${localeParam.substring(3, 5).toUpperCase()}`);

if (!locale) {
  return Astro.redirect('/404');
}

const country = countryByCode.get(locale.country);
if (!country || !country.regional) {
  return Astro.redirect('/404');
}

// Find region code from slug
let regionCode: string | null = null;
for (const [code, name] of Object.entries(country.regions)) {
  const slug = name.toLowerCase()
    .replace(/ä/g, 'ae')
    .replace(/ö/g, 'oe')
    .replace(/ü/g, 'ue')
    .replace(/ß/g, 'ss')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
  
  if (slug === regionSlug) {
    regionCode = code;
    break;
  }
}

if (!regionCode) {
  return Astro.redirect('/404');
}

const regionFullName = country.regions[regionCode];
const settings = defaultSettings(locale.country, year);
settings.region = regionCode;
settings.budget = locale.defaultBudget;

const files = filesFor(settings);
const file = readHolidayFile(locale.country, year);

if (!file) {
  return Astro.redirect('/404');
}

// Calculate bridge plans for different budgets
const bridgePlans = calculateBridgePlans(
  locale.country,
  regionCode,
  year,
  files,
  [1, 3, 5, 10, locale.defaultBudget]
);

// Get the full plan for the default budget
const input = toPlanInput(
  settings,
  yearsNeeded(settings).map((y) => files.find((f) => f.year === y)),
  buildToday
);
const fullPlan = plan(input);
const stats = fullPlan.stats;

// Get top 3 breaks
const top = [...fullPlan.breaks]
  .filter((b) => b.leave > 0)
  .sort((a, b) => b.length / b.leave - a.length / a.leave)
  .slice(0, 3);

// Build title and description
const regionText = ` ${regionFullName}`;
const title = replaceTokens(locale.translations.pageTitle, {
  year,
  region: regionText,
  leave: locale.defaultBudget,
  total: stats.daysOff
});

const description = replaceTokens(locale.translations.pageDescription, {
  year,
  region: ` in ${regionFullName}`,
  leave: locale.defaultBudget,
  total: stats.daysOff
});

const h1 = replaceTokens(locale.translations.h1Region, { year, region: regionFullName });

const canonicalPath = `/${localeParam}/${slug}-${year}/${regionSlug}/`;
const canonicalUrl = new URL(canonicalPath, SITE.url).href;

// Build hreflang links
const hreflangs: Array<{ lang: string; url: string }> = [];
hreflangs.push({ lang: locale.lang, url: canonicalUrl });
hreflangs.push({ lang: 'x-default', url: `${SITE.url}/${locale.country.toLowerCase()}/${year}/` });

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: `leavemaxxing: ${locale.bridgeTerm} ${year} ${regionFullName}`,
      url: canonicalUrl,
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Any",
      inLanguage: locale.lang,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "leavemaxxing", item: SITE.url },
        { "@type": "ListItem", position: 2, name: country.name, item: `${SITE.url}/${locale.country.toLowerCase()}/` },
        { "@type": "ListItem", position: 3, name: `${locale.bridgeTerm} ${year}`, item: `${SITE.url}/${localeParam}/${slug}-${year}/` },
        { "@type": "ListItem", position: 4, name: regionFullName, item: canonicalUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: locale.translations.faq.map(item => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer
        }
      }))
    }
  ],
};

// Get regional holidays
const regionalHolidays = file.holidays.filter(h => 
  h.regions && h.regions.includes(regionCode)
);
const nationalHolidays = file.holidays.filter(h => 
  h.national !== false && (!h.regions || h.regions.length === 0)
);
---

<Base 
  title={title} 
  description={description} 
  lang={locale.lang}
  canonical={canonicalUrl}
  hreflangs={hreflangs}
  jsonLd={jsonLd}
  wide
>
  <div class="flex flex-col gap-2 pb-5 pt-2">
    <nav aria-label="Breadcrumb" class="text-sm font-semibold text-muted">
      <a href="/" class="hover:text-ink">Planner</a> /
      <a href={`/${locale.country.toLowerCase()}/`} class="hover:text-ink">{country.name}</a> / 
      <a href={`/${localeParam}/${slug}-${year}/`} class="hover:text-ink">{locale.bridgeTerm} {year}</a> /
      <span aria-current="page">{regionFullName}</span>
    </nav>
    <h1 class="text-[clamp(28px,4vw,44px)] font-extrabold leading-tight">
      {country.flag} {h1}
    </h1>
  </div>

  <div class="prose prose-slate max-w-none mb-8">
    <p class="text-lg">
      {replaceTokens(locale.translations.intro, {
        year,
        budget: locale.defaultBudget,
        total: stats.daysOff,
        multiplier: stats.multiplier.toFixed(1)
      })}
    </p>
    {regionalHolidays.length > 0 && (
      <p class="text-muted">
        In {regionFullName} gelten {regionalHolidays.length} zusätzliche regionale Feiertage.
      </p>
    )}
  </div>

  <!-- Interactive Planner -->
  <Planner client:load initial={settings} files={files} today={buildToday} mode="page" years={[year]} />

  <div class="mt-10 grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_340px]">
    <!-- Main content -->
    <div class="flex flex-col gap-8">
      <!-- Best Plans Section -->
      <section class="card p-5 sm:p-6">
        <h2 class="text-2xl font-bold mb-4">{replaceTokens(locale.translations.bestPlansHeading, { year })}</h2>
        <div class="space-y-6">
          {bridgePlans.filter(p => p.budget <= 10).map((bridgePlan) => (
            <div class="border-l-4 border-lime pl-4">
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-3xl font-extrabold text-lime-ink">{bridgePlan.multiplier.toFixed(1)}×</span>
                <span class="text-muted">
                  {bridgePlan.budget} {locale.translations.leaveDays.toLowerCase()} → {bridgePlan.daysOff} {locale.translations.daysOff.toLowerCase()}
                </span>
              </div>
              <div class="text-sm space-y-1">
                {bridgePlan.breaks.slice(0, 3).map((br) => {
                  const formatted = formatBreak(br);
                  return (
                    <div class="text-muted">
                      {formatted.dates}: {br.leave} {locale.translations.leaveDays.toLowerCase()} → {br.length} {locale.translations.totalDays}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Holidays List -->
      <section>
        <h2 class="text-2xl font-bold mb-4">{replaceTokens(locale.translations.holidaysHeading, { year })}</h2>
        <HolidayList file={file} />
      </section>

      <!-- FAQ Section -->
      <section class="card p-5 sm:p-6">
        <h2 class="text-2xl font-bold mb-4">{locale.translations.faqHeading}</h2>
        <div class="space-y-6">
          {locale.translations.faq.map((item) => (
            <div>
              <h3 class="font-bold text-lg mb-2">{item.question}</h3>
              <p class="text-muted">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- Sidebar -->
    <aside class="flex flex-col gap-5">
      {
        top.length > 0 && (
          <section class="card p-5 sm:p-6">
            <h2 class="text-xl font-bold">{locale.translations.bestPlansHeading.replace(` ${year}`, '')}</h2>
            <p class="mt-1 text-sm text-muted">Mit {settings.budget} Tagen.</p>
            <ol class="mt-4 flex flex-col gap-3">
              {top.map((b) => (
                <li class="flex items-center gap-3">
                  <span class="grid h-11 w-14 shrink-0 place-items-center rounded-2xl bg-lime font-display text-lg font-extrabold text-lime-ink">
                    {(b.length / b.leave).toFixed(1)}×
                  </span>
                  <span class="text-sm">
                    <span class="block font-bold">{formatRange(b.start, b.end)}</span>
                    <span class="text-muted">
                      {b.leave} {locale.translations.leaveDays.toLowerCase()} → {b.length} {locale.translations.totalDays}
                    </span>
                  </span>
                </li>
              ))}
            </ol>
          </section>
        )
      }
      <section class="card p-5 sm:p-6">
        <h2 class="text-xl font-bold">{locale.translations.otherYears}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {[2027, 2028].filter(y => y !== year).map((y) => (
            <li>
              <a class="chip" href={`/${localeParam}/${slug}-${y}/${regionSlug}/`}>
                {y}
              </a>
            </li>
          ))}
        </ul>
      </section>
      {locale.translations.otherRegions && (
        <section class="card p-5 sm:p-6">
          <h2 class="text-xl font-bold">{locale.translations.otherRegions}</h2>
          <ul class="mt-3 flex flex-col gap-1 max-h-64 overflow-y-auto text-sm">
            {Object.entries(country.regions).map(([code, name]) => {
              if (code === regionCode) return null;
              const slug = name.toLowerCase()
                .replace(/ä/g, 'ae')
                .replace(/ö/g, 'oe')
                .replace(/ü/g, 'ue')
                .replace(/ß/g, 'ss')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-|-$/g, '');
              return (
                <li>
                  <a href={`/${localeParam}/${locale.slug}-${year}/${slug}/`} class="hover:text-lime-ink hover:underline">
                    {name}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}
      <section class="card p-5 sm:p-6">
        <h2 class="text-xl font-bold">{locale.translations.calculator}</h2>
        <p class="mt-2 text-sm text-muted mb-3">
          Passe den Plan an deine Bedürfnisse an.
        </p>
        <a href={`/${locale.country.toLowerCase()}/${year}/?r=${regionCode}`} class="chip inline-block">
          {locale.translations.calculatorLink}
        </a>
      </section>
    </aside>
  </div>
</Base>
