---
import HolidayList from "~/components/HolidayList.astro";
import SeasonalIntro from "~/components/SeasonalIntro.astro";
import Planner from "~/components/planner/Planner";
import { countries, countryByCode, meta, ogYear } from "~/data";
import { buildToday, readHolidayFile, serverPlan } from "~/data/server";
import { locales, UKRAINE_MARTIAL_LAW_NOTICE } from "~/data/locales";
import { SITE } from "~/data/site";
import { englishCountryAlternates } from "~/lib/hreflang";
import { shouldIndexCountry, shouldIndexYear } from "~/data/sitemap-config";
import Base from "~/layouts/Base.astro";
import { formatRange } from "~/lib/dates";
import { englishCount } from "~/i18n/format";
import { bridgeLinkLabel, bridgePath, localizedSeasonal, pageJsonLd } from "~/lib/seasonalSeo";
import { defaultSettings } from "~/lib/settings";

export function getStaticPaths() {
  return countries.flatMap((c) => meta.years.map((year) => ({ params: { cc: c.code.toLowerCase(), year: String(year) } })));
}

const code = Astro.params.cc.toUpperCase();
const year = Number(Astro.params.year);
const country = countryByCode.get(code)!;
const settings = defaultSettings(code, year);
const { plan, files } = serverPlan(settings);
const file = readHolidayFile(code, year)!;
const { stats } = plan;
const top = [...plan.breaks].filter((b) => b.leave > 0).sort((a, b) => b.length / b.leave - a.length / a.leave).slice(0, 3);

const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const seasonal =
  year === 2027 || year === 2028
    ? localizedSeasonal({
        localeCode: "en",
        year,
        where: `in ${country.name}`,
        regional: false,
        file,
        country: code,
        region: null,
        budget: settings.budget,
        daysOff: stats.daysOff,
        multiplier: stats.multiplier,
        breaks: plan.breaks,
        uiLocale: "en",
        fit: true,
      })
    : null;
const title = seasonal
  ? seasonal.title
  : `${country.name} ${year}: turn ${settings.budget} leave days into ${stats.daysOff} days off`;
const description = seasonal
  ? seasonal.description
  : `The best days to take off in ${country.name} in ${year}. ${settings.budget} leave days around ${country.name}'s public holidays give ${stats.daysOff} days off (${stats.multiplier.toFixed(1)}×). Change the days, region and style to plan your own.`;
const otherYears = meta.years.filter((y) => y !== year);
const noindex = !shouldIndexCountry(code) || !shouldIndexYear(year);
const otherSeasonalYear = year === 2027 ? 2028 : year === 2028 ? 2027 : null;
const introLinks = [
  ...(otherSeasonalYear
    ? [
        {
          href: `/${code.toLowerCase()}/${otherSeasonalYear}/`,
          label: `Bridge days ${otherSeasonalYear} in ${country.name}`,
        },
      ]
    : []),
  ...Object.values(locales)
    .filter((locale) => locale.country === code)
    .sort((a, b) => a.code.localeCompare(b.code))
    .map((locale) => ({ href: bridgePath(locale, year), label: bridgeLinkLabel(locale.code, year) })),
];

const englishUrl = canonicalUrl;
const localizedAlternates = Object.entries(locales)
  .filter(([, locale]) => locale.country === code && (year === 2027 || year === 2028))
  .map(([localeCode, locale]) => ({
    code: locale.code,
    url: `${SITE.url}/${localeCode.toLowerCase()}/${locale.slug}-${year}/`,
  }));
const hreflangs = englishCountryAlternates(localizedAlternates, englishUrl);

const jsonLd = pageJsonLd({
  title,
  description,
  url: canonicalUrl,
  inLanguage: "en",
  applicationName: `leavemaxxing: ${country.name} ${year}`,
  dateModified: seasonal?.updatedDate,
  breadcrumbs: [
    { name: "Planner", item: `${SITE.url}/` },
    { name: country.name, item: `${SITE.url}/${code.toLowerCase()}/` },
    { name: String(year), item: canonicalUrl },
  ],
  faq: seasonal?.faq,
});
---

<Base title={title} description={description} image={`/og/${code.toLowerCase()}/${ogYear(year)}.png`} jsonLd={jsonLd} hreflangs={hreflangs} wide noindex={noindex}>
  <div class="flex flex-col gap-2 pb-5 pt-2">
    <nav aria-label="Breadcrumb" class="text-sm font-semibold text-muted">
      <a href="/" class="hover:text-ink">Planner</a>{" / "}<a href={`/${code.toLowerCase()}/`} class="hover:text-ink">{country.name}</a>{" / "}<span aria-current="page">{year}</span>
    </nav>
    <h1 class="text-[clamp(28px,4vw,44px)] font-extrabold leading-tight">
      {country.flag} Best days to take off in {country.name} {year}
    </h1>
    {code === "UA" && <p class="mt-3 text-sm text-muted">{UKRAINE_MARTIAL_LAW_NOTICE}</p>}
  </div>

  {
    seasonal && (
      <SeasonalIntro
        sentences={seasonal.intro}
        links={introLinks}
        updatedLabel={seasonal.updatedLabel}
        updatedDate={seasonal.updatedDate}
      />
    )
  }

  <Planner client:load initial={settings} files={files} today={buildToday} mode="page" years={meta.years} />

  <div class="mt-10 grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_340px]">
    <HolidayList file={file} />
    <aside class="flex flex-col gap-5">
      {
        top.length > 0 && (
          <section class="card p-5 sm:p-6">
            <h2 class="text-xl font-bold">Best value breaks</h2>
            <p class="mt-1 text-sm text-muted">With {settings.budget} days and the balanced style.</p>
            <ol class="mt-4 flex flex-col gap-3">
              {top.map((b) => (
                <li class="flex items-center gap-3">
                  <span class="grid h-11 w-14 shrink-0 place-items-center rounded-2xl bg-lime font-display text-lg font-extrabold text-lime-ink">
                    {(b.length / b.leave).toFixed(1)}×
                  </span>
                  <span class="text-sm">
                    <span class="block font-bold">{formatRange(b.start, b.end)}</span>
                    <span class="text-muted">
                      {englishCount(b.leave, "leave day", "leave days")} for {englishCount(b.length, "day off", "days off")}
                    </span>
                  </span>
                </li>
              ))}
            </ol>
          </section>
        )
      }
      <section class="card p-5 sm:p-6">
        <h2 class="text-xl font-bold">Other years</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            otherYears.map((y) => (
              <li>
                <a class="chip" href={`/${code.toLowerCase()}/${y}/`}>
                  {y}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>
  </div>

  {
    seasonal && (
      <section class="card mt-5 p-5 sm:p-6">
        <h2 class="text-2xl font-bold mb-4">Common questions</h2>
        <div class="space-y-6" data-seasonal-faq>
          {seasonal.faq.map((item) => (
            <div>
              <h3 class="font-bold text-lg mb-2">{item.question}</h3>
              <p class="text-muted">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }
</Base>
